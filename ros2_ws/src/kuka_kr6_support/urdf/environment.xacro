<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- ============================================================ -->
  <!--  Environment elements for KUKA KR6 R900 workcell             -->
  <!--  Include this file from the top-level robot xacro.            -->
  <!--  All positions/orientations are adjustable via xacro props.   -->
  <!-- ============================================================ -->

  <!-- ── KUKA robot position in world ──────────────────────────────── -->
  <xacro:property name="kuka_x"       default="0"/>
  <xacro:property name="kuka_y"       default="0"/>
  <xacro:property name="kuka_z"       default="0.5"/>
  <xacro:property name="kuka_R"       default="0"/>
  <xacro:property name="kuka_P"       default="0"/>
  <xacro:property name="kuka_Y"       default="0"/>

  <!-- ── Pedestal / base position ────────────────────────────────── -->
  <xacro:property name="base_env_x"   default="-0.35"/>
  <xacro:property name="base_env_y"   default="0.31"/>
  <xacro:property name="base_env_z"   default="-0.53"/>
  <xacro:property name="base_env_R"   default="1.57"/>
  <xacro:property name="base_env_P"   default="0"/>
  <xacro:property name="base_env_Y"   default="0"/>

  <!-- ── Mesa position ───────────────────────────────────────────── -->
  <xacro:property name="mesa_x"       default="0.25"/>
  <xacro:property name="mesa_y"       default="-0.75"/>
  <xacro:property name="mesa_z"       default="-0.53"/>
  <xacro:property name="mesa_R"       default="1.57"/>
  <xacro:property name="mesa_P"       default="0"/>
  <xacro:property name="mesa_Y"       default="1.57"/>

  <!-- ── Gripper position (relative to flange) ───────────────────── -->
  <xacro:property name="gripper_x"    default="0"/>
  <xacro:property name="gripper_y"    default="0"/>
  <xacro:property name="gripper_z"    default="0"/>
  <xacro:property name="gripper_R"    default="0"/>
  <xacro:property name="gripper_P"    default="1.57"/>
  <xacro:property name="gripper_Y"    default="0"/>

  <!-- ── Cubo position (relative to gripper) ─────────────────────── -->
  <xacro:property name="cubo_x"       default="-0.02"/>
  <xacro:property name="cubo_y"       default="-0.015"/>
  <xacro:property name="cubo_z"       default="0.02"/>
  <xacro:property name="cubo_R"       default="0"/>
  <xacro:property name="cubo_P"       default="0"/>
  <xacro:property name="cubo_Y"       default="0"/>

  <!-- ── Tool selection: gripper (default) | marker ──────────────── -->
  <!-- Selecciona SOLO la geometria representada dentro de gripper_env_link.
       No crea links, joints ni frames nuevos: la cadena cinematica, el flange
       y el TCP son identicos para ambos valores.                              -->
  <xacro:arg name="tool" default="gripper"/>
  <xacro:property name="tool" value="$(arg tool)"/>

  <!-- ── Robot vertical offset (raises KUKA relative to env) ───── -->
  <!-- Increase to raise the robot above the pedestal/mesa          -->
  <xacro:property name="robot_z_offset" default="0"/>

  <!-- ── Material for environment objects ────────────────────────── -->
  <material name="env_gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="env_dark">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>
  <material name="env_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <!-- ============================================================ -->
  <!--  0. world link – KUKA robot position in world frame           -->
  <!--     Allows positioning the entire robot (e.g. on the pedestal)-->
  <!-- ============================================================ -->
  <link name="world"/>

  <joint name="world_to_base_link" type="fixed">
    <origin xyz="${kuka_x} ${kuka_y} ${kuka_z}"
            rpy="${kuka_R} ${kuka_P} ${kuka_Y}"/>
    <parent link="world"/>
    <child  link="base_link"/>
  </joint>

  <!-- ============================================================ -->
  <!--  1. base_env_link – pedestal / base soporte del KUKA          -->
  <!-- ============================================================ -->
  <link name="base_env_link">
    <visual>
      <!-- Ajuste SOLO de la malla (el frame del link, el joint y el KUKA NO se mueven):
           traslacion vertical PURA de dz = -0.030334282 m en Z de base_link,
           expresada en el frame del link como R^T*(0,0,dz) con rpy = 1.57 0 0.
           Resultado: Z_max(base.stl) = 0.000 m = cara inferior de la base del KUKA
           (contacto exacto, sin penetracion). X, Y y rpy quedan intactos. -->
      <origin xyz="0 -0.030334272 -0.000024156" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/base.stl" scale="1 1 1"/>
      </geometry>
      <material name="env_dark"/>
    </visual>
    <collision>
      <!-- Mismo desplazamiento que <visual>: collision y visual siguen superpuestos. -->
      <origin xyz="0 -0.030334272 -0.000024156" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/base.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_env_joint" type="fixed">
    <origin xyz="${base_env_x} ${base_env_y} ${base_env_z - robot_z_offset}"
            rpy="${base_env_R} ${base_env_P} ${base_env_Y}"/>
    <parent link="base_link"/>
    <child  link="base_env_link"/>
  </joint>

  <!-- ============================================================ -->
  <!--  2. mesa_env_link – mesa de trabajo frente al robot           -->
  <!-- ============================================================ -->
  <link name="mesa_env_link">
    <visual>
      <!-- Ajuste SOLO de la malla (el frame del link, el joint y el KUKA NO se mueven):
           traslacion vertical PURA de dz = -0.030413915 m en Z de base_link,
           expresada en el frame del link como R^T*(0,0,dz) con rpy = 1.57 0 1.57.
           Resultado: Z_min(patas mesa) = Z_min(base.stl) = -0.560334282 m,
           es decir ambas apoyan en el mismo plano. X, Y y rpy quedan intactos. -->
      <origin xyz="0 -0.030413905 -0.000024219" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/mesa.stl" scale="1 1 1"/>
      </geometry>
      <material name="env_gray"/>
    </visual>
    <collision>
      <!-- Mismo desplazamiento que <visual>: collision y visual siguen superpuestos. -->
      <origin xyz="0 -0.030413905 -0.000024219" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/mesa.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="mesa_env_joint" type="fixed">
    <origin xyz="${mesa_x} ${mesa_y} ${mesa_z - robot_z_offset}"
            rpy="${mesa_R} ${mesa_P} ${mesa_Y}"/>
    <parent link="base_link"/>
    <child  link="mesa_env_link"/>
  </joint>

  <!-- ============================================================ -->
  <!--  3. gripper_env_link – gripper fijo al flange del robot       -->
  <!-- ============================================================ -->
  <link name="gripper_env_link">
    <!-- Herramienta seleccionable:  tool:=gripper (por defecto) | tool:=marker
         Las dos ramas son mutuamente excluyentes; comparten este mismo link,
         el mismo frame y el mismo gripper_env_joint (que NO se toca). -->
    <xacro:if value="${tool == 'gripper'}">
    <visual>
      <!-- Ajuste SOLO de la malla (el frame del link NO se mueve):
           eje longitudinal del STL (+X mesh) alineado con +Z del link,
           eje del collar trasero (Y=39.04mm, Z=19.2mm del STL) sobre el eje del flange,
           cara ESTRUCTURAL de la placa base (x=8.858mm del STL) al ras del flange.
           El collar y los pasadores (x<8.858mm) quedan alojados dentro del
           cilindro del flange (r=18.2mm < 20mm, 8.8mm < 13.5mm de largo). -->
      <origin xyz="0.0192 -0.03904 -0.008858" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/gripper.stl" scale="1 1 1"/>
      </geometry>
      <material name="env_dark"/>
    </visual>
    <collision>
      <!-- Volumen fisico del gripper para MoveIt2: misma malla y EXACTAMENTE la
           misma transformacion que <visual>, para que collision y visual coincidan. -->
      <origin xyz="0.0192 -0.03904 -0.008858" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/gripper.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    </xacro:if>

    <xacro:if value="${tool == 'marker'}">
    <visual>
      <!-- Ajuste SOLO de la malla (mismo frame que el gripper, sin tocar el joint):
           eje longitudinal del STL (+Y mesh, 0..147mm) alineado con +Z del link,
           eje de la placa de montaje (X=22.5mm, Z=22.5mm del STL) sobre el eje
           del flange, y cara de montaje (disco de 45mm en y=0) al ras del flange.
           El yaw de 2.35619 rad (135 deg) es un giro PURO sobre el eje de la
           herramienta: deja el talon de montaje arriba y no altera ni el apoyo
           ni la coaxialidad. -->
      <origin xyz="0 -0.0318198 0" rpy="1.5708 0 2.35619"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/marker.stl" scale="1 1 1"/>
      </geometry>
      <material name="env_gray"/>
    </visual>
    <collision>
      <!-- Volumen fisico del marcador para MoveIt2: misma malla y EXACTAMENTE la
           misma transformacion que su <visual>. -->
      <origin xyz="0 -0.0318198 0" rpy="1.5708 0 2.35619"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/marker.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    </xacro:if>
  </link>

  <joint name="gripper_env_joint" type="fixed">
    <origin xyz="${gripper_x} ${gripper_y} ${gripper_z}"
            rpy="${gripper_R} ${gripper_P} ${gripper_Y}"/>
    <parent link="flange"/>
    <child  link="gripper_env_link"/>
  </joint>

  <!-- ============================================================ -->
  <!--  4. cubo_env_link – cubo sujetado por el gripper              -->
  <!-- ============================================================ -->
  <link name="cubo_env_link">
    <!-- El cubo es la pieza que sujeta el gripper: solo se representa con
         tool:=gripper. Con tool:=marker el link y su cubo_env_joint siguen
         existiendo (frame y TF intactos, referencias del SRDF validas) pero
         no llevan geometria, asi que no se ve nada. -->
    <xacro:if value="${tool == 'gripper'}">
    <visual>
      <!-- Ajuste SOLO visual: centra el cubo (30mm) entre las mordazas, sobre el eje
           del gripper y a 118mm del flange (zona de agarre; puntas a 144mm).
           Compensa el offset del cubo_env_joint, que NO se toca. -->
      <origin xyz="0.005 0 0.083" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/cubo.stl" scale="1 1 1"/>
      </geometry>
      <material name="env_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_kr6_support/meshes/environment/cubo.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    </xacro:if>
  </link>

  <joint name="cubo_env_joint" type="fixed">
    <origin xyz="${cubo_x} ${cubo_y} ${cubo_z}"
            rpy="${cubo_R} ${cubo_P} ${cubo_Y}"/>
    <parent link="gripper_env_link"/>
    <child  link="cubo_env_link"/>
  </joint>

</robot>
