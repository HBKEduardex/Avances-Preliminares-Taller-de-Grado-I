<?xml version="1.0" encoding="UTF-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════
  kuka_kr6_baseline.srdf — CONDICION MOVEIT2 BASE
  ═══════════════════════════════════════════════════════════════════════════

  DIFERENCIAS DELIBERADAS respecto a kuka_kr6_moveit_config/config/kuka_kr6.srdf:

  1. GRUPO POR CADENA (forma del Setup Assistant) en lugar de lista de joints,
     declarado base_link -> tool0, que es lo que produce un Setup Assistant
     real con este URDF (tool0 es el tip convencional, REP-199).

     El SRDF afinado define el grupo por LISTA DE JOINTS, lo que deja el tip
     implicito en link_6. Se verifico que el cambio NO altera la cinematica:

       - joint_a6-flange : xyz="0 0 0" rpy="0 0 0"            -> flange == link_6
       - flange-tool0    : xyz="0 0 0" rpy="0 ${radians(90)} 0" -> rotacion PURA

       Los tres frames (link_6, flange, tool0) comparten EXACTAMENTE el mismo
       origen. Como el Jacobiano geometrico es Jv_i = a_i x (p_tip - o_i) y
       Jw_i = a_i, y p_tip es identico, el Jacobiano es BIT A BIT IDENTICO en
       los tres casos: |J - J(link_6)|_max = 0.000e+00 exacto, verificado en
       HOME baseline, HOME afinado y una configuracion arbitraria.
       rank, sigma_min y cond(J) no cambian. Ver README seccion 10.0.

       Joints incluidos: identicos, joint_a1..joint_a6. KDL resuelve 6 GDL en
       ambos casos (los joints fijos no aportan grados de libertad).

     UNICA consecuencia real: la referencia de ORIENTACION de los objetivos
     cartesianos queda girada +90 deg en Y respecto a link_6. En el HOME
     baseline el tip muestra A/B/C = [0, 90, 0] y no [0, 0, 0].

  2. GROUP_STATE "home" CON A5 = 0 (HOME ORIGINAL DEL ROBOT).
     El SRDF afinado usa A5 = 1.57 rad. Ese valor es un ajuste posterior
     del operador y NO pertenece a la condicion base.
     ADVERTENCIA DOCUMENTADA: A5 = 0 alinea los ejes de A4 y A6 y produce
     una SINGULARIDAD DE MUÑECA exacta (rank(J) = 5, sigma_min = 7.85e-17).
     Se conserva a proposito: es la condicion que el estudio debe evidenciar.
     Ver README seccion 10.

  3. group_state "ready": NO se incluye. Es un estado definido por el
     operador, no un producto del Setup Assistant.

  MATRIZ DE COLISIONES: NO VERIFICADO.
     El Setup Assistant la genera por muestreo aleatorio y no se puede
     ejecutar en este entorno (prohibido lanzar procesos). La matriz se copia
     literalmente del SRDF afinado porque es una propiedad geometrica del
     modelo, no un ajuste orientado a las metricas del estudio, y sin ella
     el robot queda en autocolision permanente y no planifica nada.
     Ver README seccion 10 (limitaciones).
-->
<robot name="kuka_kr6r900sixx">

    <!-- ── Grupo de planificacion: cadena, tip = tool0 ─────────────── -->
    <group name="manipulator">
        <chain base_link="base_link" tip_link="tool0"/>
    </group>

    <!-- ── HOME ORIGINAL (A5 = 0). Singular. No corregir. ──────────── -->
    <group_state name="home" group="manipulator">
        <joint name="joint_a1" value="0.0"/>
        <joint name="joint_a2" value="-1.5707963"/>
        <joint name="joint_a3" value="1.5707963"/>
        <joint name="joint_a4" value="0.0"/>
        <joint name="joint_a5" value="0.0"/>
        <joint name="joint_a6" value="0.0"/>
    </group_state>

    <!-- ── Matriz de colisiones (copiada, NO VERIFICADO) ───────────── -->
    <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
    <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
    <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
    <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
    <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
    <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
    <disable_collisions link1="link_3" link2="link_5" reason="Never"/>
    <disable_collisions link1="link_3" link2="link_6" reason="Never"/>

    <disable_collisions link1="base_env_link" link2="mesa_env_link" reason="Never"/>
    <disable_collisions link1="base_env_link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="mesa_env_link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_env_link" link2="link_6" reason="Adjacent"/>
    <disable_collisions link1="gripper_env_link" link2="cubo_env_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_env_link" link2="link_5" reason="Never"/>
    <disable_collisions link1="cubo_env_link" link2="link_6" reason="Never"/>
    <disable_collisions link1="cubo_env_link" link2="link_5" reason="Never"/>
    <disable_collisions link1="base_env_link" link2="link_1" reason="Never"/>
</robot>
