<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kuka_gui_moveit_bridge</name>
  <version>0.1.0</version>
  <description>
    Puente entre una GUI externa y MoveIt/RViz para el robot KUKA KR6.
    Recibe comandos articulares y cartesianos en grados desde la GUI,
    convierte internamente a radianes y envia objetivos a MoveIt2 via /move_action.
    Incluye un nodo de GUI de prueba (Tkinter) interno.
  </description>
  <maintainer email="eduardex@todo.com">eduardex</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>kuka_kr6_moveit_config</exec_depend>
  <exec_depend>kuka_pick_place_demo</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
